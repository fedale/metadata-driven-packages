#!/usr/bin/env php
<?php

declare(strict_types=1);

use Fedale\PackageCatalog\CatalogBuilder;
use Fedale\PackageCatalog\Command\BuildCommand;
use Fedale\PackageCatalog\Command\CheckCommand;
use Fedale\PackageCatalog\Owners\GitHubOrganizationMembers;
use Fedale\PackageCatalog\PullRequestCheck;
use Fedale\PackageCatalog\Site\SiteBuilder;
use Fedale\PackageFormat\Archive;
use Fedale\PackageFormat\DocumentCodec;
use Fedale\PackageFormat\FieldTypes\FieldTypeCatalog;
use Fedale\PackageFormat\PackageChecker;
use Fedale\PackageFormat\PackageDirectory;
use Fedale\PackageFormat\SchemaValidator;
use Fedale\PackageFormat\SeedRecords;
use Fedale\PackageFormat\Versions\ItemStates;
use Symfony\Component\Console\Application;
use Symfony\Component\HttpClient\HttpClient;

require dirname(__DIR__).'/vendor/autoload.php';

$reader = new PackageDirectory(new DocumentCodec());
$checker = new PackageChecker(new SchemaValidator(), new FieldTypeCatalog(), new SeedRecords());

$application = new Application('metadata-driven package catalog');
$application->addCommand(new CheckCommand(new PullRequestCheck($reader, $checker, new ItemStates(new FieldTypeCatalog()), new GitHubOrganizationMembers(HttpClient::create(), getenv('GITHUB_TOKEN') ?: null))));
$application->addCommand(new BuildCommand(new CatalogBuilder($reader, $checker, new Archive(), new SiteBuilder(new SeedRecords()))));
$application->run();
